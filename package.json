{
  "name": "cr-dual-subs",
  "version": "0.1.0",
  "private": true,
  "description": "Bilingual subtitles for Crunchyroll: shows a machine-translated line under the original subtitle.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "bridge": "node bridge/server.mjs",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wxt": "^0.20.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "zod": "^4.6.7"
  }
}
